{
  "name": "velvet",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "VELVET Discord card game and local music bot",
  "main": "index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "deploy:commands": "node deploy-commands.js",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "check": "node --check index.js && node --check client.js && node --check db.js",
    "lint": "node --check *.js"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.44.4",
    "ffmpeg-static": "^5.2.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.4"
  }
}
